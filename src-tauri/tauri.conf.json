{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JPDBMLEditor",
  "version": "0.1.1",
  "identifier": "com.junpeiwada.jpdbmleditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JPDBMLEditor",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Junpeiwada/JPDBMLEditor/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2NzQ1QzdFRTBGRDU1OQpSV1JaMVEvdXgwVm5DMHhwL3U0Q3ZaaXB4TkFGVzNCUkI2ODFYbXllRnhLZjlEbytpek55ZmRLUwo="
    }
  }
}
